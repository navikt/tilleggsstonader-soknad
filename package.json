{
    "name": "tilleggsstonader-soknad",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "ci": "yarn --prefer-offline --no-frozen-lockfile && yarn --cwd src/backend ci",
        "build": "yarn lint && PUBLIC_URL=/tilleggsstonader/soknad webpack --config ./webpack/webpack.production.js && yarn --cwd src/backend build",
        "build:dev": "PUBLIC_URL=/tilleggsstonader/soknad webpack --config ./webpack/webpack.development.js",
        "start:dev": "PUBLIC_URL=/tilleggsstonader/soknad webpack serve --config ./webpack/webpack.development.js",
        "postinstall": "husky",
        "prepare": "husky",
        "lint": "biome check src/",
        "lint:fix": "biome check --write src/"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@biomejs/biome": "^2.5.11",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@types/react-router-dom": "^5.3.3",
        "@types/uuid": "^11.0.0",
        "babel-loader": "^10.1.0",
        "cookie-parser": "^1.4.7",
        "css-loader": "^7.1.1",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.0",
        "typescript": "^7.0.2",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-middleware": "^8.1.1",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1"
    },
    "dependencies": {
        "@grafana/faro-react": "^2.9.0",
        "@nais/apm": "0.6.0",
        "@navikt/aksel-icons": "^8.16.1",
        "@navikt/ds-css": "^8.16.1",
        "@navikt/ds-react": "^8.16.1",
        "@navikt/ds-tokens": "^8.10.2",
        "@navikt/nav-dekoratoren-moduler": "^4.3.0",
        "@tanstack/react-query": "^5.101.0",
        "axios": "^1.19.0",
        "constate": "^4.0.0",
        "date-fns": "^4.4.0",
        "i18n-iso-countries": "^7.14.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.18.0",
        "styled-components": "^6.5.1",
        "uuid": "^14.0.2"
    },
    "resolutions": {
        "styled-components": "^6",
        "qs": "^6.15.2"
    }
}
