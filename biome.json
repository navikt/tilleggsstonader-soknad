{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },

    "formatter": {
        "enabled": true,
        "lineWidth": 100,
        "indentWidth": 4,
        "indentStyle": "space"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "none",
            "arrowParentheses": "always",
            "semicolons": "always"
        }
    },

    "linter": {
        "enabled": true,
        "rules": {
            "correctness": {
                "noUnusedImports": "warn",
                "noUnusedVariables": "warn",
                "useHookAtTopLevel": "error",
                "useExhaustiveDependencies": "warn"
            },
            "suspicious": {
                "noConsole": "warn"
            },
            "style": {
                "useImportType": "off"
            }
        }
    },

    "files": {
        "includes": [
            "**",
            "!src/backend/build",
            "!.nais",
            "!dist_*",
            "!tests",
            "!.github",
            "!webpack"
        ]
    },
    "overrides": [
        {
            "includes": ["src/backend/tokenx.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        }
    ]
}
